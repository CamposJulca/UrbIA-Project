# 🔐 Token de acceso a la API de ThingsBoard (colócalo manualmente o genera uno)
THINGSBOARD_TOKEN=eyJhbGciOiJIUz...

# 🌐 URL base del servidor ThingsBoard
THINGSBOARD_API_URL=https://demo.thingsboard.io

# 🧩 Puerto en el que se ejecutará la API backend
BACKEND_PORT=8000

# 📚 Nivel de logs (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
